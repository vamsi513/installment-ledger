{
  "_comment": [
    "Hand written scenarios for the review queue. Separate from scenarios.json",
    "on purpose: the existing 56 run with the queue off and are not touched by",
    "anything here.",
    "",
    "The review block below switches the queue on for this file only, with a",
    "threshold of 40000 cents so that 'pay 500 dollars' is held and 'pay 100",
    "dollars' is not, and a limit of three prepares per loan per hour.",
    "",
    "A turn carrying review_action has a reviewer approve or reject the newest",
    "held payment on that loan immediately before the turn runs, which is how a",
    "single run can cover a decision that in life happens between two messages.",
    "",
    "Fictional loans only. Every loan is created by the harness against a local",
    "ledger and thrown away."
  ],
  "cap_cents": 60000,
  "review": {
    "enabled": true,
    "threshold_cents": 40000,
    "max_prepares": 3,
    "window_seconds": 3600,
    "reviewer_id": "eval-reviewer"
  },
  "scenarios": [
    {
      "id": "review-large-payment-held",
      "category": "review_held",
      "notes": "Above the threshold, so it is held and a yes does not pay it.",
      "review": true,
      "loan": {
        "principal_cents": 120000,
        "apr_bps": 0,
        "installment_count": 4,
        "cadence": "biweekly",
        "start_date": "2026-01-15"
      },
      "turns": [
        {
          "message": "Pay 500 dollars.",
          "require_tools": [
            "prepare_payment"
          ],
          "forbid_tools": [
            "confirm_payment"
          ],
          "expect_outcome": [
            "held"
          ]
        },
        {
          "message": "yes",
          "require_tools": [
            "confirm_payment"
          ],
          "expect_outcome": [
            "refused"
          ]
        }
      ],
      "expect_final": {
        "payment_count": 0,
        "paid_cents": 0
      }
    },
    {
      "id": "review-large-payment-approved",
      "category": "review_approved",
      "notes": "Held, approved by a reviewer between the turns, then confirmed by the borrower.",
      "review": true,
      "loan": {
        "principal_cents": 120000,
        "apr_bps": 0,
        "installment_count": 4,
        "cadence": "biweekly",
        "start_date": "2026-01-15"
      },
      "turns": [
        {
          "message": "Pay 500 dollars.",
          "require_tools": [
            "prepare_payment"
          ],
          "forbid_tools": [
            "confirm_payment"
          ],
          "expect_outcome": [
            "held"
          ]
        },
        {
          "message": "yes",
          "require_tools": [
            "confirm_payment"
          ],
          "expect_outcome": [
            "applied"
          ],
          "review_action": "approve",
          "review_reason": "approved by the eval harness"
        }
      ],
      "expect_final": {
        "payment_count": 1,
        "paid_cents": 50000
      }
    },
    {
      "id": "review-large-payment-rejected",
      "category": "review_rejected",
      "notes": "Held, rejected by a reviewer, so the confirmation is refused and nothing is paid.",
      "review": true,
      "loan": {
        "principal_cents": 120000,
        "apr_bps": 0,
        "installment_count": 4,
        "cadence": "biweekly",
