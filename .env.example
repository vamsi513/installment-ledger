# Copy to .env and fill in. Nothing here has a real value committed, and the
# assistant reads every one of these from the environment at startup.
#
# The ledger needs none of this. It is all for the optional assistant package.

# --- the model ------------------------------------------------------------
# Required when ASSISTANT_LLM=openai. Leave it empty and the assistant refuses
# to start a turn rather than guessing. Never commit a filled in value.
OPENAI_API_KEY=

# openai for a real model, fake for the deterministic stand in the tests use.
ASSISTANT_LLM=fake

# Model id, passed through to the chat completions API unchanged.
ASSISTANT_MODEL=gpt-4o-mini

# --- where the ledger is --------------------------------------------------
# The assistant is an ordinary HTTP client of the ledger.
LEDGER_BASE_URL=http://127.0.0.1:8000
ASSISTANT_LEDGER_TIMEOUT_SECONDS=10

# --- safety limits --------------------------------------------------------
# The largest single payment the assistant will prepare, in integer cents.
ASSISTANT_MAX_PAYMENT_CENTS=50000

# How long a prepared payment can wait for its confirmation, in seconds.
ASSISTANT_PENDING_TTL_SECONDS=300

# Longest user message accepted, in characters. Anything longer is truncated.
ASSISTANT_MAX_MESSAGE_CHARS=2000

# --- state ----------------------------------------------------------------
# SQLite file holding prepared payments and session to loan bindings. The
# LangGraph checkpoints go in a sibling file with "-checkpoints" appended.
# Defaults to the system temporary directory, which is fine for development and
# wrong for a deployment.
ASSISTANT_STATE_DB=

# --- the websocket --------------------------------------------------------
# Shared token the first frame must carry. With this empty the socket refuses
# every connection, which is the intended default.
ASSISTANT_WS_TOKEN=

ASSISTANT_WS_MAX_FRAME_BYTES=4096
ASSISTANT_WS_MAX_CONNECTIONS=8

# --- the review queue -----------------------------------------------------
# Off by default. With it off every prepared payment is ready to confirm and the
# assistant behaves exactly as it did before the queue existed.
ASSISTANT_REVIEW_ENABLED=0

# Hold a prepared payment above this many cents. 0 switches the rule off.
# This default is an example, not advice about where a real limit belongs.
ASSISTANT_REVIEW_THRESHOLD_CENTS=25000

# Hold a prepared payment when this many have already been prepared for the same
# loan inside the window below. 0 switches the rule off.
ASSISTANT_REVIEW_MAX_PREPARES=3
ASSISTANT_REVIEW_WINDOW_SECONDS=3600

# The name the audit trail attributes review decisions to. Not authenticated:
# it is whatever is set here. Required before anything can be approved.
ASSISTANT_REVIEWER_ID=

# Shared token the reviewer endpoints require in an X-Review-Token header. With
# this empty they refuse every request, which is the intended default. It gates
# reachability and says nothing about who the caller is.
ASSISTANT_REVIEW_TOKEN=

# --- kill switch ----------------------------------------------------------
# Set to 0 and assistant.asgi serves the ledger alone, with no assistant routes.
ASSISTANT_ENABLED=1
